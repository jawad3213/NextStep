<div class="cv-document cv-document-horizon" style="{{ root_style }}">
  <div class="cv-sheet cv-sheet-horizon">
    <header class="cv-hz-header" data-editor-section-id="header" data-editor-section-title="Header">
      <div class="cv-hz-identity">
        {% if candidate.photo_url != blank %}
        <img class="cv-hz-avatar" src="{{ candidate.photo_url }}" alt="{{ candidate.name }}" />
        {% else %}
        <div class="cv-hz-avatar cv-hz-avatar-fallback">{{ candidate.initials }}</div>
        {% endif %}
        <h1>{{ candidate.name }}</h1>
      </div>
      <ul class="cv-hz-contact">
        {% if candidate.email != blank %}<li>{{ candidate.email }}</li>{% endif %}
        {% if candidate.phone != blank %}<li>{{ candidate.phone }}</li>{% endif %}
        {% if candidate.location != blank %}<li>{{ candidate.location }}</li>{% endif %}
        {% for link in profile_links %}<li>{{ link.href }}</li>{% endfor %}
      </ul>
    </header>

    <div class="cv-hz-body">
      <main class="cv-hz-main">
        {% for section in main_sections %}
        <section class="cv-section" data-editor-section-id="{{ section.id }}" data-editor-section-title="{{ section.title }}">
          <h2 class="cv-hz-title">{{ section.title }}</h2>
          {% if section.id == "summary" %}
            <p class="cv-summary">{{ section.text }}</p>
          {% elsif section.id == "certifications" %}
            <ul class="cv-hz-plain-list">
            {% for item in section.items %}
              <li><strong>{{ item.primary_text }}</strong>{% if item.secondary_text != blank %} · {{ item.secondary_text }}{% endif %}</li>
            {% endfor %}
            </ul>
          {% else %}
            <div class="cv-hz-timeline">
            {% for item in section.items %}
              <article class="cv-entry">
                <div class="cv-entry-head">
                  <strong>{{ item.primary_text }}</strong>
                  {% if item.date_range != blank %}<span class="cv-hz-date">{{ item.date_range }}</span>{% endif %}
                </div>
                {% if item.secondary_text != blank %}<p class="cv-entry-sub">{{ item.secondary_text }}{% if item.location != blank %} · {{ item.location }}{% endif %}</p>{% endif %}
                {% if item.description != blank %}<p class="cv-entry-description">{{ item.description }}</p>{% endif %}
                {% if item.bullets.size > 0 %}
                <ul class="cv-bullet-list">
                  {% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}
                </ul>
                {% endif %}
              </article>
            {% endfor %}
            </div>
          {% endif %}
        </section>
        {% endfor %}
      </main>

      {% if has_sidebar %}
      <aside class="cv-hz-side">
        {% for section in sidebar_sections %}
        <section class="cv-section" data-editor-section-id="{{ section.id }}" data-editor-section-title="{{ section.title }}">
          <h2 class="cv-hz-title">{{ section.title }}</h2>
          {% if section.id == "skills" %}
            <div class="cv-hz-tags">
              {% for item in section.items %}<span class="cv-hz-tag{% if item.is_matched %} matched{% endif %}">{{ item.primary_text }}</span>{% endfor %}
            </div>
          {% else %}
            <ul class="cv-hz-side-list">
              {% for item in section.items %}
              <li>
                <strong>{{ item.primary_text }}</strong>
                {% if item.secondary_text != blank %}<span>{{ item.secondary_text }}</span>{% endif %}
                {% if item.date_range != blank %}<span>{{ item.date_range }}</span>{% endif %}
              </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
        {% endfor %}
      </aside>
      {% endif %}
    </div>
  </div>
</div>
