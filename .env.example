
# ============================================================
# NextStep — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=nextstep
POSTGRES_PASSWORD=nextstep
POSTGRES_DB=nextstep_db

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=votre-mot-de-passe-admin

# --- Keycloak Client Secret (.NET backend) ---
Keycloak__ClientSecret=VOTRE_SECRET_CLIENT_KEYCLOAK

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# --- Base de données (.NET EF Core) ---
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=nextstep_db;Username=nextstep;Password=nextstep

# --- Agents Python — URL backend .NET ---
DOTNET_BACKEND_URL=http://backend:5000

# --- Agents Python — URL base PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://nextstep:nextstep@postgres:5432/nextstep_db

# --- Agents Python — Base URL pour .NET (dans docker-compose) ---
AgentPython__BaseUrl=http://agents-python:8000

# ─────────────────────────────────────────────────
# M2 — LLM Provider (choisir UN des deux)
# ─────────────────────────────────────────────────
LLM_PROVIDER=groq

# Option A : Groq (recommandé — gratuit, rapide)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Option B : OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# --- Redis (Hangfire, cache) ---
REDIS_URL=redis://redis:6379
