# ============================================================
# NextStep — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=nextstep_user
POSTGRES_PASSWORD=password
POSTGRES_DB=nextstep_db

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak_db
Keycloak__ClientSecret=SECRET_HERE

# --- Infrastructure ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=password

# --- ASP.NET Core Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=nextstep_db;Username=nextstep;Password=nextstep

# --- Python Agents ---
DOTNET_BACKEND_URL=http://backend:5000
DATABASE_URL=postgresql+asyncpg://nextstep:nextstep@postgres:5432/nextstep_db

# --- LLM Global Configuration ---
# Priority order for fallback (e.g., "gemini,groq,openai")
LLM_PROVIDER_PRIORITY=groq,gemini,openai
LLM_TEMPERATURE=0.1

# Agent-specific priorities (Forces Gemini for these tasks)
LLM_PRIORITY_SKILL_GAP=gemini,groq
LLM_PRIORITY_CV_OPTIMIZER=gemini,groq

# --- Groq (Fast & Free) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_PRECISE=llama-3.3-70b-versatile

# --- Gemini (Google) ---
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (Optional) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Search API ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# --- Agent-Specific Overrides (Optional) ---
# Gemini overrides (e.g., gemini-2.0-flash or gemini-1.5-pro)
GEMINI_MODEL_SKILL_GAP=gemini-2.0-flash
GEMINI_MODEL_CV_OPTIMIZER=gemini-2.0-flash

# Groq overrides
GROQ_MODEL_CV_OPTIMIZER=llama-3.3-70b-versatile

# --- SonarQube ---
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_password
SONAR_DB_NAME=sonar
