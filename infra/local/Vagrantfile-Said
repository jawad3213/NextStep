Vagrant.configure("2") do |config|
  # Lightweight Ubuntu Image
  config.vm.box = "bento/ubuntu-24.04"

  # ==========================================
  # VM 1 : Backend (Said's PC)
  # ==========================================
  config.vm.define "backend-said" do |node|
    node.vm.hostname = "backend-said"
    
    # Public Network (Bridged to Wi-Fi) on the 192.168.11.x Subnet
    node.vm.network "public_network", ip: "192.168.11.220"
    
    node.vm.provider "vmware_desktop" do |v|
      v.cpus = 2
      v.memory = 2048
      v.vmx["displayname"] = "Said-Backend"
    end
  end

  # ==========================================
  # VM 2 : Frontend (Said's PC)
  # ==========================================
  config.vm.define "frontend-said" do |node|
    node.vm.hostname = "frontend-said"
    
    # Public Network (Bridged to Wi-Fi) on the 192.168.11.x Subnet
    node.vm.network "public_network", ip: "192.168.11.221"
    
    node.vm.provider "vmware_desktop" do |v|
      v.cpus = 2
      v.memory = 2048
      v.vmx["displayname"] = "Said-Frontend"
    end
  end
end
