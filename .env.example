# ============================================================
# NextStep — Variables d'environnement RACINE (Docker Compose)
# ============================================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env
# ⚠️ NE JAMAIS COMMIT le fichier .env (il est dans .gitignore)

# ============================================================
# 1. INFRASTRUCTURE & SHARED SECRETS
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=votre-mot-de-passe-securise
POSTGRES_DB=nextstep_db

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=votre-mot-de-passe-admin


# ============================================================
# 2. BACKEND (.NET 8)
# ============================================================

# --- Keycloak Client Secret ---
Keycloak__ClientSecret=VOTRE_SECRET_CLIEN_KEYCLOAK


# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000


# ============================================================
# 3. AGENTS IA (Python FastAPI)
# ============================================================

# --- LLM Provider API Keys (choisir un au moins) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx


