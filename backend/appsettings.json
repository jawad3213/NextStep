{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Keycloak": {
    "Authority": "http://localhost:8080/realms/Next-Step",
    "Audience": "nextstep-api",
    "RequireHttpsMetadata": false
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nextstep_db;Username=nextstep;Password=nextstep"
  },

  "PythonAgents": {
    "Url": "http://localhost:8000"
  },

  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5000/api/email-connections/google/callback"
  },

  "EmailFollowUp": {
    "MaxFollowUps": 2,
    "DelayDays": 7,
    "DelayMinutes": null,
    "DelayDaysBetweenFollowUps": 7,
    "DelayMinutesBetweenFollowUps": null
  }
}