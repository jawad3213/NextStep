  \label{tab:endpoints_profile_backend}
  \begin{tabularx}{\textwidth}{llX}
    \toprule
    \textbf{Méthode} & \textbf{Endpoint} & \textbf{Rôle} \\
    \midrule
    GET              & \texttt{/api/profile}                  & Charger le profil complet \\
    PUT              & \texttt{/api/profile/personal-info}    & Mettre à jour les infos personnelles \\
