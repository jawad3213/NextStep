    "Se renseigner sur la stratégie Green Mining"
  ]
}
\end{verbatim}

\section{Gestion d'erreurs et résilience}

\begin{itemize}[leftmargin=2em]
  \item \textbf{Fallback LLM} : rapport de secours généré si le parsing JSON échoue.
  \item \textbf{Cooldown automatique} : providers en erreur 429 temporairement
    désactivés.
  \item \textbf{Scraping résilient} : détection des pages bloquées, retry avec
    backoff, sémaphores.
  \item \textbf{Troncature intelligente} : contenu limité avec message
    \texttt{[CONTENU TRONQUÉ]} pour respecter les limites TPM du LLM.
  \item \textbf{Validation Pydantic} : contraintes \texttt{Field(ge=0, le=100)} sur
    les modèles d'entrée et de sortie.
  \item \textbf{Logging structuré} : chaque étape tracée avec niveaux INFO/WARNING/ERROR.
\end{itemize}

